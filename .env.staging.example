# ── Base de données (serveur externe) ──
APP_DATABASE_URL=postgresql+asyncpg://user:password@staging-db-host:5432/daf_augmente

# ── Redis (serveur externe) ──
REDIS_URL=redis://staging-redis-host:6379/0
CELERY_BROKER_URL=redis://staging-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://staging-redis-host:6379/2

# ── Sécurité ──
SECRET_KEY=change-me-with-a-secure-secret-key-min-32-chars
BACKEND_CORS_ORIGINS=https://staging.example.com,https://app-staging.example.com

# ── Frontend (optionnel si besoin de build-time vars) ──
NEXT_PUBLIC_API_URL=https://staging-api.example.com
